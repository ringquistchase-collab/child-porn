# ── Full bridge runner ────────────────────────────────────────────────────────

class MiningPoolBridge:
    """
    Connects the private DNA-locked chain to the wider public ecosystem.
    """

    def __init__(self):
        self.ots      = OpenTimestampsAnchor()
        self.eth      = EthereumAnchor()

    def full_bridge(self, chain_tip_hash: str,
                    verified_claims: List[Dict] = None) -> Dict:
        """
        Run the full bridge: anchor to Bitcoin + Ethereum, surface DeSci options,
        query genomic pools, pull brain data pool metadata.
        """
        results = {"chain_tip_hash": chain_tip_hash[:20] + "...",
                   "timestamp": time.time(), "connections": {}}

        # 1 — Bitcoin anchoring via OpenTimestamps → mempool → mining pools
        results["connections"]["bitcoin_timestamp"] = self.ots.submit_hash(chain_tip_hash)

        # 2 — Ethereum smart contract
        results["connections"]["ethereum_anchor"] = self.eth.anchor_chain_tip(chain_tip_hash)

        # 3 — DeSci protocol options
        results["connections"]["desci_protocols"] = {
            k: {"name":v["name"],"focus":v["focus"],"relevance":v["relevance"]}
            for k,v in DESCI_PROTOCOLS.items()
        }

        # 4 — Genomic data pools
        results["connections"]["genomic_pools"] = {
            k: {"name":v["name"],"org":v["org"],"type":v["type"],
                "free":v["free"],"relevance":v["relevance"]}
            for k,v in GENOMIC_POOLS.items()
        }

        # 5 — Brain/EEG data pools
        results["connections"]["brain_data_pools"] = {
            k: {"name":v["name"],"org":v["org"],"type":v["type"],
                "records":v["records"],"key_datasets":v["key_datasets"][:2],
                "relevance":v["relevance"]}
            for k,v in BRAIN_DATA_POOLS.items()
        }

        return results
