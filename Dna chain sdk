/**
 * Query available AI models and return consensus.
 * Models that throw (not configured) are silently skipped.
 * @param {string} prompt
 * @param {string} context
 * @param {object} aiRegistry
 * @param {number} minConvergence  — fraction of models that must agree (0-1)
 * @returns {Promise<{response: string, models_used: string[], convergence: number}>}
 */
async function iceConsensus(prompt, context, aiRegistry, minConvergence = 0.6) {
  const results = [];
  for (const [name, service] of Object.entries(aiRegistry)) {
    if (service.status !== 'ACTIVE' && !service.status.includes('NEEDS')) continue;
    try {
      const text = await service.call(prompt, context);
      if (text && text.length > 20) results.push({ name, text });
    } catch (_) {
      // Not configured — skip silently
    }
  }
  if (!results.length) return { response: 'No AI services available.', models_used: [], convergence: 0 };

  // Simple convergence: fraction of models that returned a response
  const convergence = results.length / Object.keys(aiRegistry).length;
  // Primary response from Claude if available, otherwise first result
  const primary = results.find(r => r.name === 'claude') || results[0];
  return {
    response: primary.text,
    models_used: results.map(r => r.name),
    convergence: Math.round(convergence * 100) / 100,
  };
}


