/**
 * Broadcast a mined block to all local blockchain nodes.
 * Fails silently if nodes are not running — safe to call always.
 * @param {object} block — from mineBlock()
 * @param {number[]} ports — default [5001, 5002, 5003]
 * @returns {Promise<{broadcast: number, failed: number}>}
 */
async function gossipBlock(block, ports = [5001, 5002, 5003]) {
  let broadcast = 0, failed = 0;
  for (const port of ports) {
    try {
      const r = await fetch(`http://localhost:${port}/mine`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(block.payload),
        signal: AbortSignal.timeout(2000),
      });
      if (r.ok) broadcast++; else failed++;
    } catch (_) {
      failed++;  // Node not running — normal in sandbox
    }
  }
  return { broadcast, failed };
}


// ─────────────────────────────────────────────────────────────
// SECTION 10: MAIN CLASS — DNAChain
// Ties everything together. This is what you import.
// ─────────────────────────────────────────────────────────────

class DNAChain {
  /**
   * @param {object} cfg
   * @param {string} [cfg.anthropicKey]  — ANTHROPIC_API_KEY
   * @param {string} [cfg.openaiKey]     — OPENAI_API_KEY
   * @param {string} [cfg.googleKey]     — GOOGLE_API_KEY
   * @param {string} [cfg.mistralKey]    — MISTRAL_API_KEY
   * @param {string} [cfg.cohereKey]     — COHERE_API_KEY
   * @param {string} [cfg.groqKey]       — GROQ_API_KEY
   * @param {string} [cfg.hfToken]       — HF_TOKEN
   * @param {string} [cfg.ollamaBase]    — default http://localhost:11434
   * @param {string} [cfg.pinataJwt]     — PINATA_JWT (IPFS)
   * @param {string} [cfg.genomeAnchor]  — override default genome anchor
   */
  constructor(cfg = {}) {
    this.cfg           = cfg;
    this.genomeAnchor  = cfg.genomeAnchor || GENOME_ANCHOR;
    this.ai            = buildAIRegistry(cfg);
    this.localBlocks   = [];  // blocks mined this session
    this.serviceStatus = SERVICE_STATUS;
  }

  /** Print honest status of all connected services. */
  status() {
    console.log('\n=== DNA Chain — Service Status ===');
    for (const [svc, info] of Object.entries(SERVICE_STATUS)) {
      const mark = info.status === 'ACTIVE' ? '✓' : '○';
      console.log(`  ${mark} ${svc.padEnd(18)} ${info.status.padEnd(8)} — ${info.note}`);
    }
    console.log('');
  }

  /**
   * Mine a block with genome anchor embedded.
   * @param {object} payload
   * @param {number} diff
   * @param {string} label
   * @param {function} [onProgress]
   */
  async mine(payload, diff = 2, label = '', onProgress = null) {
    const block = await mineBlock(
      { ...payload, genome_anchor: this.genomeAnchor },
      diff, label, onProgress
    );
    block.das = computeDAS(block);
    this.localBlocks.push(block);
    // Attempt to gossip to nodes (fails safely if not running)
    gossipBlock(block).then(g => {
      if (g.broadcast > 0) console.log(`  ⬡ Gossiped to ${g.broadcast} node(s)`);
    });
    return block;
  }

  /**
   * Search across a corpus of blocks.
   * @param {string} query
   * @param {Array} corpus
   * @param {number} topK
   */
  async search(query, corpus, topK = 6) {
    return searchCorpus(query, corpus, topK);
  }

  /**
   * Score a block with DAS.
   * @param {{ label: string, diff: number }} block
   */
  score(block) {
    return computeDAS(block);
  }

  /**
   * Generate plain language for a label across reading levels and languages.
   * @param {string} label
   * @param {number} das
   */
  translate(label, das) {
    return toPlainLanguage(label, das);
  }

  /**
   * Query Claude (or available AI) for synthesis.
   * Falls back gracefully if key not set.
   * @param {string} prompt
   * @param {string} [context]
   */
  async ask(prompt, context = '') {
    try {
      return await this.ai.claude.call(prompt, context);
    } catch (e) {
      return `Claude not configured: ${e.message}`;
    }
  }

  /**
   * Multi-model ICE consensus — queries all configured AI services.
   * @param {string} prompt
   * @param {string} context
   */
  async consensus(prompt, context = '') {
    return iceConsensus(prompt, context, this.ai);
  }

  /**
   * Export chain blocks as LLM training data (JSONL).
   * @param {Array} blocks
   * @param {number} minDiff
   */
  exportTraining(blocks, minDiff = 3) {
    return exportTrainingData(blocks, minDiff);
  }

  /** Look up a technical term in the vocabulary library. */
  vocab(term) {
    return VOCAB[term] || null;
  }
}


