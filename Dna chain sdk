/**
 * Convert a chain block into an LLM instruction pair.
 * Exports JSONL-compatible object for HuggingFace dataset.
 * @param {{ label: string, diff: number, chain: string }} block
 * @returns {object}
 */
function toTrainingPair(block) {
  const { das, grade } = computeDAS(block);
  const evidence =
    block.diff >= 6 ? 'definitively proven in living biology' :
    block.diff >= 5 ? 'confirmed by multiple independent sources' :
    block.diff >= 4 ? 'validated against published research' :
    block.diff >= 3 ? 'clinical evidence'                    : 'observational data';

  return {
    prompt: `Explain this validated blockchain research finding: "${block.label?.slice(0, 80)}"`,
    response: `Chain record (${evidence}, confidence ${block.diff}/6, DAS ${das.toFixed(2)} ${grade}): ${block.label}. This finding is part of the DNA-locked blockchain voice sovereignty research system (MIT licence, open source).`,
    language: 'en',
    das_score: das,
    das_grade: grade,
    diff: block.diff,
    source_chain: block.chain || 'unknown',
    consent_scope: 'anonymised_research',
    source: 'dna-chain-research',
  };
}

/**
 * Export chain blocks as a HuggingFace-compatible JSONL string.
 * @param {Array} blocks
 * @param {number} minDiff  — only export blocks at this difficulty or higher
 * @returns {string} JSONL
 */
function exportTrainingData(blocks, minDiff = 3) {
  return blocks
    .filter(b => (b.diff || 0) >= minDiff && b.label)
    .map(b => JSON.stringify(toTrainingPair(b)))
    .join('\n');
}


