// ─────────────────────────────────────────────────────────────
// SECTION 2: MINING — SHA-256 PROOF OF WORK
// Works identically in browser (crypto.subtle) and Node.js (crypto)
// ─────────────────────────────────────────────────────────────

/**
 * Compute SHA-256 hash — works in browser and Node.js.
 * @param {string} str
 * @returns {Promise<string>} hex digest
 */
async function sha256(str) {
  if (typeof crypto !== 'undefined' && crypto.subtle) {
    // Browser / Deno / modern Node.js
    const buf = await crypto.subtle.digest(
      'SHA-256', new TextEncoder().encode(str)
    );
    return Array.from(new Uint8Array(buf))
      .map(b => b.toString(16).padStart(2, '0')).join('');
  } else {
    // Node.js < 19 without globalThis.crypto
    const { createHash } = await import('crypto');
    return createHash('sha256').update(str).digest('hex');
  }
}

/**
 * Mine a block at the given difficulty.
 * @param {object} payload  — the data to mine
 * @param {number} diff     — number of leading zeros required (1-6)
 * @param {string} label    — human-readable description
 * @param {function} [onProgress] — called every 500 nonces with (nonce, partialHash)
 * @returns {Promise<{hash, nonce, diff, label, timestamp, payload}>}
 */
async function mineBlock(payload, diff = 2, label = '', onProgress = null) {
  const prefix = '0'.repeat(diff);
  const data = JSON.stringify({ ...payload, label }, (_, v) =>
    typeof v === 'bigint' ? v.toString() : v
  );
  const t0 = Date.now();
  let nonce = 0;

  while (true) {
    const h = await sha256(data + nonce);
    if (h.startsWith(prefix)) {
      return {
        hash: h,
        nonce,
        diff,
        label,
        timestamp: new Date().toISOString(),
        ms: Date.now() - t0,
        payload,
      };
    }
    nonce++;
    if (nonce % 500 === 0) {
      if (onProgress) onProgress(nonce, h);
      // Yield to event loop so UI stays responsive
      await new Promise(r => setTimeout(r, 0));
    }
  }
}


// ─────────────────────────────────────────────────────────────
// SECTION 3: DNA ALGORITHM SCORE (DAS)
// 6-dimensional quality score for any chain block (1.0 – 6.0)
// Like MOS (Mean Opinion Score) but for research evidence
// ─────────────────────────────────────────────────────────────

/**
 * Compute the 6-dimensional DAS score for a block.
 * @param {{ label: string, diff: number }} block
 * @returns {{ das: number, grade: string, dims: object }}
 */
function computeDAS(block) {
  const label = (block.label || '').toLowerCase();
  const diff  = block.diff || 1;

  const CONF_UP   = ['confirmed','validated','in vivo','evidence','sovereign','legal','genesis'];
  const CONF_DOWN = ['predicted','estimated','inferred','temporal','gap','simulated'];
  const CROSS_SIG = ['cross','chain','family','research','study','ibc','corrobor','multi'];
  const TIME_SIG  = ['2024','2025','2026','doi','nature','science','baseline','30-day'];
  const AI_SIG    = ['claude','llm','federation','ai','model','synthesis','rag','bert'];
  const RES_SIG   = ['brca','sod1','clinvar','gnomad','tcga','doi','nature','crpd','w3c','finra','ots'];

  const d1 = diff / 6;
  let d2 = 0.75 + 0.05 * CONF_UP.filter(s => label.includes(s)).length;
  d2 -= 0.15 * CONF_DOWN.filter(s => label.includes(s)).length;
  d2 = Math.max(0.1, Math.min(1.0, d2));
  const d3 = Math.min(1.0, 0.3 + 0.1 * CROSS_SIG.filter(s => label.includes(s)).length);
  const d4 = Math.min(1.0, 0.5 + 0.08 * TIME_SIG.filter(s => label.includes(s)).length);
  const d5 = Math.min(1.0, 0.4 + 0.1  * AI_SIG.filter(s => label.includes(s)).length);
  const d6 = Math.min(1.0, 0.3 + 0.07 * RES_SIG.filter(s => label.includes(s)).length);

  const [w1,w2,w3,w4,w5,w6] = [0.35,0.15,0.12,0.13,0.12,0.13];
  const composite = w1*d1 + w2*d2 + w3*d3 + w4*d4 + w5*d5 + w6*d6;
  const das = Math.round((1.0 + composite * 5.0) * 1000) / 1000;

  const grade =
    das >= 5.0 ? 'DEFINITIVE' :
    das >= 4.0 ? 'HIGH'       :
    das >= 3.0 ? 'MODERATE'   :
    das >= 2.0 ? 'DEVELOPING' : 'PRELIMINARY';

  return { das, grade, dims: { d1,d2,d3,d4,d5,d6 } };
}


// ─────────────────────────────────────────────────────────────
// SECTION 4: CROSS-CHAIN SEARCH (RAG)
// SHA-256 semantic embedding — deterministic, no GPU needed
// Upgrade path: swap embed() for BioBERT 768-dim when available
// ─────────────────────────────────────────────────────────────

/**
 * Embed text to a 32-float vector via SHA-256.
 * For production: replace with BioBERT 768-dim via @xenova/transformers
 * @param {string} text
 * @returns {Promise<number[]>}
 */
async function embed(text) {
  const h = await sha256(text.toLowerCase());
  const bytes = Array.from({ length: 32 }, (_, i) =>
    parseInt(h.slice(i * 2, i * 2 + 2), 16)
  );
  const mag = Math.sqrt(bytes.reduce((s, b) => s + b * b, 0)) || 1;
  return bytes.map(b => b / mag);
}

/** Cosine similarity between two vectors. */
function cosine(a, b) {
  const dot = a.reduce((s, v, i) => s + v * b[i], 0);
  const ma  = Math.sqrt(a.reduce((s, v) => s + v * v, 0));
  const mb  = Math.sqrt(b.reduce((s, v) => s + v * v, 0));
  return ma && mb ? dot / (ma * mb) : 0;
}

/**
 * Search a corpus of blocks for the most relevant results.
 * @param {string} query
 * @param {Array<{label:string, chain:string, diff:number}>} corpus
 * @param {number} topK
 * @returns {Promise<Array>}
 */
async function searchCorpus(query, corpus, topK = 6) {
  const qEmb = await embed(query);
  const scored = await Promise.all(
    corpus.map(async block => {
      const bEmb = await embed(block.label || '');
      const sim  = cosine(qEmb, bEmb);
      const { das } = computeDAS(block);
      return { ...block, sim, das, score: sim * (0.7 + 0.3 * das / 6) };
    })
  );
  return scored
    .sort((a, b) => b.score - a.score)
    .slice(0, topK);
}


